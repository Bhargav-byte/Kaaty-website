{
  "name": "kaaty-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "size": "size-limit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "350 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/*.css",
      "limit": "50 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "convex": "^1.46.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
