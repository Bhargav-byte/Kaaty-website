# -----------------------------------------------------------------------------
# KAATY Landing Page — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file with real values.
# -----------------------------------------------------------------------------

# -- Convex (PUBLIC — safe to expose to the browser) --------------------------
# Get this from: https://dashboard.convex.dev ? your project ? Settings ? URL
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Used by `npx convex dev` CLI only (local development)
CONVEX_DEPLOYMENT=your-deployment-name

# Convex HTTP actions base URL (same deployment, .convex.site suffix)
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# -----------------------------------------------------------------------------
# ??  RESEND_API_KEY must be set in the CONVEX DASHBOARD only.
# It must NEVER have the VITE_ prefix.
# It must NEVER be placed in this file, in Netlify, or in GitHub.
# Architecture: Browser ? Convex ? Resend (server-side only)
# Set it at: https://dashboard.convex.dev ? your project ? Settings ? Environment Variables
# RESEND_API_KEY=your_resend_api_key_here
# -----------------------------------------------------------------------------
